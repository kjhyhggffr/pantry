# Server side (Vercel project env). Copy to .env.local for `pnpm dev`,
# or run `vercel env pull .env.local`.

# Set by hand ---------------------------------------------------------------

# Shared secret for /api/scan and /api/queue. Generate: openssl rand -hex 32
SCANNER_TOKEN=

# Comma-separated addresses allowed into the dashboard. Unset = nobody.
ALLOWED_EMAILS=you@example.com

# Set by the Vercel Supabase integration -------------------------------------

SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; bypasses row-level security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Used by scripts/setup-db.mjs at build time to apply migrations.
POSTGRES_URL_NON_POOLING=
