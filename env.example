# ---------------------------------------------------------------------------
# Vercel project environment variables (Settings -> Environment Variables)
# ---------------------------------------------------------------------------

# The spreadsheet's ID: the long string in its URL between /d/ and /edit
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789

# From the service-account JSON key you downloaded from Google Cloud
GOOGLE_SERVICE_ACCOUNT_EMAIL=pantry-scanner@your-project.iam.gserviceaccount.com

# The "private_key" field of that same JSON file, quoted, newlines and all.
# Pasting it into Vercel's UI with literal \n is also fine -- the code handles both.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBg...\n-----END PRIVATE KEY-----\n"

# Shared secret between the server and the scripts in agent/.
# Generate one with:  openssl rand -hex 32
SCANNER_TOKEN=replace-me-with-64-hex-characters


# ---------------------------------------------------------------------------
# agent/.env  (copy these two lines into agent/.env on the machine that has
# the scanner plugged into it)
# ---------------------------------------------------------------------------

PANTRY_SERVER_URL=https://your-project.vercel.app
# SCANNER_TOKEN=  <- exactly the same value as above
